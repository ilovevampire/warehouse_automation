<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="warehouse">

    <!-- ====================================================
         PHYSICS — Bullet Featherstone for mimic joint support
         ==================================================== -->
    <physics name="1ms" type="bullet">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- ====================================================
         REQUIRED PLUGINS
         ==================================================== -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ====================================================
         LIGHTING
         ==================================================== -->

    <!-- Primary directional sun — angled for shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.80 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Overhead work light 1 — above robot workspace -->
    <light type="point" name="work_light_1">
      <cast_shadows>false</cast_shadows>
      <pose>0.0 0.5 3.5 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>6</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <!-- Overhead work light 2 — above pick table -->
    <light type="point" name="work_light_2">
      <cast_shadows>false</cast_shadows>
      <pose>0.0 1.4 3.5 0 0 0</pose>
      <diffuse>1.0 0.98 0.92 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>5</range>
        <constant>0.3</constant>
        <linear>0.2</linear>
        <quadratic>0.05</quadratic>
      </attenuation>
    </light>

    <!-- ====================================================
         FLOOR — Concrete grey with yellow lane markings
         ==================================================== -->
    <model name="warehouse_floor">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="floor_link">
        <collision name="floor_collision">
          <geometry>
            <box><size>12.0 10.0 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.025 0 0 0</pose>
          <geometry>
            <box><size>12.0 10.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.60 0.60 0.60 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

        <!-- Yellow lane marking — main perimeter line North -->
        <visual name="lane_N">
          <pose>0 4.6 0.001 0 0 0</pose>
          <geometry><box><size>11.0 0.12 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>

        <!-- Yellow lane marking — main perimeter line South -->
        <visual name="lane_S">
          <pose>0 -4.6 0.001 0 0 0</pose>
          <geometry><box><size>11.0 0.12 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>

        <!-- Yellow lane marking — East -->
        <visual name="lane_E">
          <pose>5.6 0 0.001 0 0 0</pose>
          <geometry><box><size>0.12 9.0 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>

        <!-- Yellow lane marking — West -->
        <visual name="lane_W">
          <pose>-5.6 0 0.001 0 0 0</pose>
          <geometry><box><size>0.12 9.0 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>

        <!-- Yellow robot work cell box marking -->
        <visual name="cell_line_N">
          <pose>0 2.5 0.001 0 0 0</pose>
          <geometry><box><size>4.5 0.10 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>
        <visual name="cell_line_S">
          <pose>0 -1.8 0.001 0 0 0</pose>
          <geometry><box><size>4.5 0.10 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>
        <visual name="cell_line_E">
          <pose>2.25 0.35 0.001 0 0 0</pose>
          <geometry><box><size>0.10 4.3 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>
        <visual name="cell_line_W">
          <pose>-2.25 0.35 0.001 0 0 0</pose>
          <geometry><box><size>0.10 4.3 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.0 1</ambient>
            <diffuse>0.95 0.80 0.0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- ====================================================
         WALLS
         ==================================================== -->


    <!-- South wall — solid -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 2.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12.0 0.2 4.0</size></box></geometry>
          <material>
            <ambient>0.75 0.73 0.70 1</ambient>
            <diffuse>0.75 0.73 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>12.0 0.2 4.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- East wall (1 window) -->
    <model name="wall_east">
      <static>true</static>
      <pose>6.0 0 2.0 0 0 0</pose>
      <link name="link">
        <!-- Bottom section -->
        <visual name="wall_E_bot">
          <pose>0 0 -1.7 0 0 0</pose>
          <geometry><box><size>0.2 10.0 0.6</size></box></geometry>
          <material>
            <ambient>0.75 0.73 0.70 1</ambient>
            <diffuse>0.75 0.73 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="wall_E_bot_col">
          <pose>0 0 -1.7 0 0 0</pose>
          <geometry><box><size>0.2 10.0 0.6</size></box></geometry>
        </collision>
        <!-- Top section -->
        <visual name="wall_E_top">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 10.0 1.0</size></box></geometry>
          <material>
            <ambient>0.75 0.73 0.70 1</ambient>
            <diffuse>0.75 0.73 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="wall_E_top_col">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><box><size>0.2 10.0 1.0</size></box></geometry>
        </collision>
        <!-- Window frame -->
        <visual name="window_E_frame">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><box><size>0.18 8.0 1.8</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="window_E_glass">
          <pose>0.01 0 0.2 0 0 0</pose>
          <geometry><box><size>0.05 7.6 1.5</size></box></geometry>
          <material>
            <ambient>0.6 0.8 0.9 0.35</ambient>
            <diffuse>0.6 0.8 0.9 0.35</diffuse>
            <specular>1.0 1.0 1.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall — solid -->
    <model name="wall_west">
      <static>true</static>
      <pose>-6.0 0 2.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.2 10.0 4.0</size></box></geometry>
          <material>
            <ambient>0.75 0.73 0.70 1</ambient>
            <diffuse>0.75 0.73 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.2 10.0 4.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Ceiling -->
    <model name="ceiling">
      <static>true</static>
      <pose>0 0 4.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>12.0 10.0 0.1</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================================================
         ROBOT MOUNTING TABLE
         Professional steel-look workbench
         Size: 0.8 x 0.8 x 0.9m
         Robot base at z=0.9
         Position: (0.0, 0.0)
         ==================================================== -->
    <model name="robot_table">
      <static>true</static>
      <pose>0.0 0.0 0 0 0 0</pose>
      <link name="link">
        <!-- Tabletop -->
        <visual name="top_visual">
          <pose>0 0 0.875 0 0 0</pose>
          <geometry><box><size>0.80 0.80 0.05</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.40 0.40 0.43 1</diffuse>
            <specular>0.6 0.6 0.6 1</specular>
          </material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.875 0 0 0</pose>
          <geometry><box><size>0.80 0.80 0.05</size></box></geometry>
        </collision>
        <!-- Leg FL -->
        <visual name="leg_FL">
          <pose> 0.35  0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material>
        </visual>
        <collision name="leg_FL_col">
          <pose> 0.35  0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
        </collision>
        <!-- Leg FR -->
        <visual name="leg_FR">
          <pose> 0.35 -0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material>
        </visual>
        <collision name="leg_FR_col">
          <pose> 0.35 -0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
        </collision>
        <!-- Leg BL -->
        <visual name="leg_BL">
          <pose>-0.35  0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material>
        </visual>
        <collision name="leg_BL_col">
          <pose>-0.35  0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
        </collision>
        <!-- Leg BR -->
        <visual name="leg_BR">
          <pose>-0.35 -0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
          <material><ambient>0.25 0.25 0.27 1</ambient><diffuse>0.25 0.25 0.27 1</diffuse></material>
        </visual>
        <collision name="leg_BR_col">
          <pose>-0.35 -0.35 0.425 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.85</size></box></geometry>
        </collision>
        <!-- Cross brace -->
        <visual name="brace">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry><box><size>0.72 0.72 0.04</size></box></geometry>
          <material><ambient>0.28 0.28 0.30 1</ambient><diffuse>0.28 0.28 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ====================================================
         PICK TABLE — where boxes are initially placed
         Size: 1.2 x 0.6 x 0.75m
         Position: (0.0, 1.55) — robot rotates ~90deg to reach
         Box surface at z=0.75
         ==================================================== -->
    <model name="pick_table">
      <static>true</static>
      <pose>0.0 1.55 0 0 0 0</pose>
      <link name="link">
        <!-- Tabletop -->
        <visual name="top_visual">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.20 0.60 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.42 0.28 1</ambient>
            <diffuse>0.60 0.46 0.30 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.20 0.60 0.05</size></box></geometry>
        </collision>
        <!-- Legs -->
        <visual name="leg_FL">
          <pose> 0.55  0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.3 0.22 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_FL_col">
          <pose> 0.55  0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_FR">
          <pose> 0.55 -0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.3 0.22 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_FR_col">
          <pose> 0.55 -0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_BL">
          <pose>-0.55  0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.3 0.22 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_BL_col">
          <pose>-0.55  0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
        <visual name="leg_BR">
          <pose>-0.55 -0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
          <material><ambient>0.3 0.22 0.14 1</ambient><diffuse>0.3 0.22 0.14 1</diffuse></material>
        </visual>
        <collision name="leg_BR_col">
          <pose>-0.55 -0.27 0.35 0 0 0</pose>
          <geometry><box><size>0.05 0.05 0.70</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ====================================================
         STORAGE RACK — 2 shelves
         Size: 1.2 x 0.5 x 1.8m
         Position: (-1.6, -0.4) — robot rotates ~-120deg to place
         Shelf 1 at z=0.55, Shelf 2 at z=1.05
         ==================================================== -->
    <model name="storage_rack">
      <static>true</static>
      <pose>-1.6 -0.4 0 0 0 0</pose>
      <link name="link">

        <!-- Vertical uprights -->
        <visual name="upright_FL">
          <pose> 0.58  0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
        <collision name="upright_FL_col">
          <pose> 0.58  0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
        </collision>
        <visual name="upright_FR">
          <pose> 0.58 -0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
        <collision name="upright_FR_col">
          <pose> 0.58 -0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
        </collision>
        <visual name="upright_BL">
          <pose>-0.58  0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
        <collision name="upright_BL_col">
          <pose>-0.58  0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
        </collision>
        <visual name="upright_BR">
          <pose>-0.58 -0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.60 0.60 0.60 1</diffuse></material>
        </visual>
        <collision name="upright_BR_col">
          <pose>-0.58 -0.23 0.9 0 0 0</pose>
          <geometry><box><size>0.05 0.05 1.80</size></box></geometry>
        </collision>

        <!-- Shelf 1 at z=0.55 -->
        <visual name="shelf_1_visual">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry><box><size>1.18 0.48 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="shelf_1_col">
          <pose>0 0 0.55 0 0 0</pose>
          <geometry><box><size>1.18 0.48 0.03</size></box></geometry>
        </collision>

        <!-- Shelf 2 at z=1.05 -->
        <visual name="shelf_2_visual">
          <pose>0 0 1.05 0 0 0</pose>
          <geometry><box><size>1.18 0.48 0.03</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="shelf_2_col">
          <pose>0 0 1.05 0 0 0</pose>
          <geometry><box><size>1.18 0.48 0.03</size></box></geometry>
        </collision>

        <!-- Top cap bar -->
        <visual name="top_bar">
          <pose>0 0 1.775 0 0 0</pose>
          <geometry><box><size>1.18 0.48 0.05</size></box></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.50 0.50 0.50 1</diffuse></material>
        </visual>

        <!-- Back panel -->
        <visual name="back_panel">
          <pose>0 0.22 0.9 0 0 0</pose>
          <geometry><box><size>1.18 0.02 1.80</size></box></geometry>
          <material><ambient>0.40 0.40 0.42 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material>
        </visual>
        <collision name="back_panel_col">
          <pose>0 0.22 0.9 0 0 0</pose>
          <geometry><box><size>1.18 0.02 1.80</size></box></geometry>
        </collision>

      </link>
    </model>

    <!-- ====================================================
         BOXES — 6 boxes on pick table in 2x3 grid
         Box size: 0.07 x 0.07 x 0.07m (fits 2F-85 which opens 85mm)
         Box mass: 0.2 kg
         Table surface at z=0.75, so box center at z=0.785
         Pick table at y=1.55
         Grid: 3 cols (x: -0.18, 0.0, 0.18) x 2 rows (y: 1.35, 1.55)
         ==================================================== -->

    <model name="box_1">
      <pose>-0.18 1.35 0.785 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.000163</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>0.000163</iyy><iyz>0</iyz><izz>0.000163</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.9 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <pose>0.0 1.35 0.785 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.000163</ixx><ixy>0</ixy><ixz>0</ixz>
                   <iyy>0.000163</iyy><iyz>0</iyz><izz>0.000163</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.07 0.07 0.07</size></box></geometry>
          <material>
            <ambient>0.1 0.5 0.8 1</ambient>
            <diffuse>0.1 0.55 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <pose>0.18 1.35 0.785 0 0 0</pose>
      <link name="link">
